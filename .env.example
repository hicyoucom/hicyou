# Core application
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/hicyou
# Only used by the optional v1-to-v2 migration bridge
V1_DATABASE_URL=
DB_POOL_MAX=1
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_IP_ADDRESS_HEADERS=
TRUSTED_PROXIES=0
ADMIN_EMAILS=admin@example.com

# Public site metadata (embedded at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=HiCyou
NEXT_PUBLIC_MAIL=contact@example.com
NEXT_PUBLIC_BLOG=

# Scheduled jobs and webhook encryption
CRON_SECRET=replace-me
WEBHOOK_SECRET_KEY=replace-me

# Optional OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional email
MAIL_KEY=
MAIL_FROM="HiCyou <noreply@example.com>"

# Optional OpenAI-compatible content provider
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2
EXASEARCH_API_KEY=

# Optional S3/R2-compatible object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_UPLOAD_DIR=uploads
R2_LOGO_DIR=logos
R2_COVER_DIR=covers

# Optional Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional analytics (no production identifiers are included)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
